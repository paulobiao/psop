generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SiteStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  ARCHIVED
}

enum DeviceType {
  CAMERA
  RECORDER
  GATEWAY
  ACCESS_CONTROLLER
  SENSOR
  INTERCOM
  NETWORK_SWITCH
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  DECOMMISSIONED
}

enum DeviceMonitoringMode {
  DIRECT
  VIA_GATEWAY
  INVENTORY_ONLY
}

enum EdgeAgentDeliveryState {
  DELIVERED
  BUFFERED
  ERROR
}

model Organization {
  id             String             @id @default(uuid()) @db.Uuid
  name           String
  slug           String             @unique
  status         OrganizationStatus @default(ACTIVE)
  sites          Site[]
  users          User[]
  auditLogs      AuditLog[]
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  deletedAt      DateTime?          @map("deleted_at")
  sessions       UserSession[]
  authChallenges        AuthChallenge[]
  notificationPolicy    NotificationPolicy?
  notificationDeliveries NotificationDelivery[]

  @@map("organizations")
}

model User {
  id                    String          @id @default(uuid()) @db.Uuid
  organizationId        String          @map("organization_id") @db.Uuid
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name                  String
  email                 String          @unique
  passwordHash          String          @map("password_hash")
  mustChangePassword    Boolean         @default(false) @map("must_change_password")
  mfaEnabled            Boolean         @default(false) @map("mfa_enabled")
  mfaSecretEncrypted    String?         @map("mfa_secret_encrypted")
  mfaRecoveryCodeHashes Json?           @map("mfa_recovery_code_hashes")
  mfaEnabledAt          DateTime?       @map("mfa_enabled_at")
  role                  UserRole        @default(OPERATOR)
  status                UserStatus      @default(ACTIVE)
  lastLoginAt           DateTime?       @map("last_login_at")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  deletedAt             DateTime?       @map("deleted_at")
  auditLogs             AuditLog[]      @relation("AuditLogActor")
  sessions              UserSession[]
  authChallenges        AuthChallenge[]

  @@index([organizationId])
  @@index([status])
  @@map("users")
}

model Site {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  devices        Device[]
  name           String
  code           String
  timezone       String       @default("UTC")
  address        String?
  status         SiteStatus   @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("sites")
}

model Device {
  id                        String                     @id @default(uuid()) @db.Uuid
  siteId                    String                     @map("site_id") @db.Uuid
  site                      Site                       @relation(fields: [siteId], references: [id], onDelete: Restrict)
  name                      String
  externalId                String                     @map("external_id")
  deviceType                DeviceType                 @map("device_type")
  monitoringMode            DeviceMonitoringMode       @default(DIRECT) @map("monitoring_mode")
  gatewayDeviceId           String?                    @map("gateway_device_id") @db.Uuid
  gatewayDevice             Device?                    @relation("DeviceGateway", fields: [gatewayDeviceId], references: [id], onDelete: Restrict)
  managedDevices            Device[]                   @relation("DeviceGateway")
  manufacturer              String?
  model                     String?
  firmwareVersion           String?                    @map("firmware_version")
  ipAddress                 String?                    @map("ip_address")
  serialNumber              String?                    @map("serial_number")
  status                    DeviceStatus               @default(ACTIVE)
  expectedHeartbeatInterval Int                        @default(60) @map("expected_heartbeat_interval")
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  deletedAt                 DateTime?                  @map("deleted_at")
  alerts                    Alert[]
  ingestionCredential       DeviceIngestionCredential?
  telemetrySnapshot         DeviceTelemetrySnapshot?
  edgeAgentRuntime          EdgeAgentRuntimeSnapshot?
  connectivityEvents        DeviceConnectivityEvent[]

  @@unique([siteId, externalId])
  @@index([siteId])
  @@index([deviceType])
  @@index([monitoringMode])
  @@index([gatewayDeviceId])
  @@map("devices")
}

model DeviceIngestionCredential {
  deviceId  String   @id @map("device_id") @db.Uuid
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  keyHash   String   @map("key_hash")
  keyPrefix String   @map("key_prefix")
  rotatedAt DateTime @default(now()) @map("rotated_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("device_ingestion_credentials")
}

model DeviceTelemetrySnapshot {
  deviceId       String   @id @map("device_id") @db.Uuid
  device         Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  observedAt     DateTime @map("observed_at")
  receivedAt     DateTime @default(now()) @map("received_at")
  reportedStatus String?  @map("reported_status")
  temperatureC   Float?   @map("temperature_c")
  bitrateKbps    Int?     @map("bitrate_kbps")
  storageUsedPct Float?   @map("storage_used_pct")
  uptimeSeconds  Int?     @map("uptime_seconds")
  model          String?
  firmware       String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([observedAt])
  @@map("device_telemetry_snapshots")
}

model EdgeAgentRuntimeSnapshot {
  deviceId                 String                  @id @map("device_id") @db.Uuid
  device                   Device                  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  agentVersion             String                  @map("agent_version")
  runtimeStartedAt         DateTime                @map("runtime_started_at")
  uptimeSeconds            Int                     @map("uptime_seconds")
  deliveryState            EdgeAgentDeliveryState  @default(DELIVERED) @map("delivery_state")
  previousDeliveryState    EdgeAgentDeliveryState? @map("previous_delivery_state")
  pendingBufferCount       Int                     @default(0) @map("pending_buffer_count")
  lastSuccessfulDeliveryAt DateTime?               @map("last_successful_delivery_at")
  lastDeliveryError        String?                 @map("last_delivery_error")
  lastDeliveryErrorAt      DateTime?               @map("last_delivery_error_at")
  reportedAt               DateTime                @default(now()) @map("reported_at")
  createdAt                DateTime                @default(now()) @map("created_at")
  updatedAt                DateTime                @updatedAt @map("updated_at")

  @@index([reportedAt])
  @@index([deliveryState])
  @@map("edge_agent_runtime_snapshots")
}

model DeviceConnectivityEvent {
  id              String    @id @default(uuid()) @db.Uuid
  deviceId        String    @map("device_id") @db.Uuid
  device          Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  eventType       String    @map("event_type")
  previousState   String?   @map("previous_state")
  currentState    String    @map("current_state")
  detectedAt      DateTime  @default(now()) @map("detected_at")
  lastHeartbeatAt DateTime? @map("last_heartbeat_at")
  ageSeconds      Int?      @map("age_seconds")
  expiresAt       DateTime? @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([deviceId, detectedAt])
  @@index([detectedAt])
  @@map("device_connectivity_events")
}

enum AlertType {
  DEVICE_CONNECTIVITY
}

enum AlertStatus {
  OPEN
  RESOLVED
}

enum AlertSeverity {
  WARNING
  CRITICAL
}

enum NotificationChannel {
  EMAIL
}

enum NotificationEventType {
  INCIDENT_OPENED
  INCIDENT_RECOVERED
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_NOT_CONFIGURED
  SKIPPED_COOLDOWN
  SKIPPED_POLICY
}

model Alert {
  id                String        @id @default(uuid()) @db.Uuid
  deviceId          String        @map("device_id") @db.Uuid
  device            Device        @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  type              AlertType
  status            AlertStatus   @default(OPEN)
  severity          AlertSeverity
  title             String
  message           String
  connectivityState String?       @map("connectivity_state")
  dedupKey          String?       @unique @map("dedup_key")
  openedAt          DateTime      @default(now()) @map("opened_at")
  lastDetectedAt    DateTime      @default(now()) @map("last_detected_at")
  resolvedAt        DateTime?     @map("resolved_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  notificationDeliveries NotificationDelivery[]

  @@index([deviceId, status])
  @@index([status, createdAt])
  @@map("alerts")
}

model NotificationPolicy {
  id                     String        @id @default(uuid()) @db.Uuid
  organizationId         String        @unique @map("organization_id") @db.Uuid
  organization           Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enabled                Boolean       @default(false)
  minimumSeverity        AlertSeverity @default(CRITICAL) @map("minimum_severity")
  notifyOnRecovery       Boolean       @default(true) @map("notify_on_recovery")
  notifyAdmins           Boolean       @default(true) @map("notify_admins")
  notifyOperators        Boolean       @default(true) @map("notify_operators")
  explicitEmails         String[]      @default([]) @map("explicit_emails")
  cooldownMinutes        Int           @default(0) @map("cooldown_minutes")
  escalationDelayMinutes Int           @default(0) @map("escalation_delay_minutes")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  @@map("notification_policies")
}

model NotificationDelivery {
  id             String                     @id @default(uuid()) @db.Uuid
  organizationId String                     @map("organization_id") @db.Uuid
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  alertId        String                     @map("alert_id") @db.Uuid
  alert          Alert                      @relation(fields: [alertId], references: [id], onDelete: Cascade)
  eventType      NotificationEventType      @map("event_type")
  channel        NotificationChannel        @default(EMAIL)
  recipientEmail String                     @map("recipient_email")
  recipientSource String                    @map("recipient_source")
  status         NotificationDeliveryStatus @default(PENDING)
  dedupKey       String                     @unique @map("dedup_key")
  subject        String
  body           String
  eligibleAt     DateTime                   @default(now()) @map("eligible_at")
  attemptCount   Int                        @default(0) @map("attempt_count")
  lastAttemptAt  DateTime?                  @map("last_attempt_at")
  nextAttemptAt  DateTime?                  @map("next_attempt_at")
  sentAt         DateTime?                  @map("sent_at")
  lastError      String?                    @map("last_error")
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")

  @@index([organizationId, createdAt])
  @@index([organizationId, status, eligibleAt])
  @@index([alertId, eventType])
  @@index([recipientEmail, sentAt])
  @@map("notification_deliveries")
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorUserId    String?      @map("actor_user_id") @db.Uuid
  actor          User?        @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorName      String       @map("actor_name")
  actorEmail     String       @map("actor_email")
  actorRole      String       @map("actor_role")
  action         String
  entityType     String       @map("entity_type")
  entityId       String?      @map("entity_id")
  method         String
  path           String
  statusCode     Int          @map("status_code")
  ipAddress      String?      @map("ip_address")
  userAgent      String?      @map("user_agent")
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model UserSession {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId           String       @map("user_id") @db.Uuid
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String       @map("refresh_token_hash")
  ipAddress        String?      @map("ip_address")
  userAgent        String?      @map("user_agent")
  expiresAt        DateTime     @map("expires_at")
  lastUsedAt       DateTime     @default(now()) @map("last_used_at")
  revokedAt        DateTime?    @map("revoked_at")
  createdAt        DateTime     @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

model AuthChallenge {
  id             String       @id @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId         String       @map("user_id") @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String
  ipAddress      String?      @map("ip_address")
  userAgent      String?      @map("user_agent")
  expiresAt      DateTime     @map("expires_at")
  usedAt         DateTime?    @map("used_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([userId, type, usedAt, expiresAt])
  @@index([organizationId, createdAt])
  @@map("auth_challenges")
}
