NODE_ENV=development\nPORT=3100\nDATABASE_URL=postgresql://psop:psop_dev@localhost:5433/psop?schema=public\nAWS_REGION=us-east-1\nDYNAMODB_STATUS_TABLE=camera-fleet-monitor-status\nTELEMETRY_OFFLINE_MULTIPLIER=2\nDYNAMODB_EVENTS_TABLE=camera-fleet-monitor-events\nCONNECTIVITY_EVENT_RETENTION_DAYS=90\n\nCONNECTIVITY_MONITOR_ENABLED=true\nCONNECTIVITY_MONITOR_INTERVAL_SECONDS=60\nCONNECTIVITY_MONITOR_INITIAL_DELAY_SECONDS=5\n
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_SECONDS=43200

JWT_REFRESH_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_EXPIRES_SECONDS=2592000

MFA_ENCRYPTION_KEY=replace-with-64-hex-characters

TELEMETRY_DEMO_MODE=false

LOCAL_TELEMETRY_INGESTION_ENABLED=false

# Operational Health Engine V2
# Deterministic anti-flapping for DIRECT devices going OFFLINE by heartbeat.
# 1 = disabled (default). N>1 requires N consecutive OFFLINE evaluations before
# an incident opens. Recorder-verified / authoritative OFFLINE is never delayed.
CONNECTIVITY_FLAP_MIN_CONSECUTIVE=1
