{
  "version": 1,
  "probeId": "22222222-2222-4222-8222-222222222222",
  "apiUrl": {"envFile": ".env.speco.local", "key": "PSOP_API_URL"},
  "stateFile": "state/stream-scheduler-state.json",
  "schedule": {
    "intervalSeconds": 300,
    "durationSeconds": 5,
    "timeoutSeconds": 3,
    "maxCheckSeconds": 30,
    "evidenceValiditySeconds": 60,
    "maxConcurrentRecorders": 2,
    "maxBackoffSeconds": 1800,
    "deliverySeconds": 15,
    "maxPendingRows": 100
  },
  "recorders": [
    {
      "id": "example-site-nvr-1",
      "integration": "NVR_RTSP_MANUAL_URI",
      "deviceId": "33333333-3333-4333-8333-333333333333",
      "host": "192.0.2.10",
      "deviceKey": {"envFile": ".env.speco.local", "key": "PSOP_SPECO_RECORDER_DEVICE_KEY"},
      "credentials": {
        "username": {"prompt": "example-site-nvr-1 RTSP username"},
        "password": {"prompt": "example-site-nvr-1 RTSP password"}
      },
      "bindingSource": {"format": "SPECO_MAP", "file": "speco.local.json"},
      "targets": [
        {"channelNumber": 1, "channelKey": "{00000001-0000-0000-0000-000000000000}",
         "deviceId": "11111111-1111-4111-8111-111111111111", "uri": "rtsp://192.0.2.10:554/chID=1&streamType=main"},
        {"channelNumber": 2, "channelKey": "{00000002-0000-0000-0000-000000000000}",
         "deviceId": "11111111-1111-4111-8111-111111111112", "uri": "rtsp://192.0.2.10:554/chID=2&streamType=main"}
      ]
    },
    {
      "id": "example-site-nvr-2",
      "integration": "NVR_RTSP_MANUAL_URI",
      "deviceId": "44444444-4444-4444-8444-444444444444",
      "host": "198.51.100.20",
      "deviceKey": {"env": "PSOP_EXAMPLE_NVR_2_DEVICE_KEY"},
      "credentials": {
        "username": {"env": "PSOP_EXAMPLE_NVR_2_RTSP_USERNAME"},
        "password": {"env": "PSOP_EXAMPLE_NVR_2_RTSP_PASSWORD"}
      },
      "targets": [
        {"channelNumber": 4, "deviceId": "55555555-5555-4555-8555-555555555555",
         "uri": "rtsp://198.51.100.20:554/example/stream?channel=4"}
      ]
    }
  ]
}
