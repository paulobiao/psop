{
  "name": "psop",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "pnpm --filter api exec jest --runInBand",
    "dev": "turbo dev",
    "build": "turbo build",
    "check:prisma": "pnpm --filter api exec prisma validate && pnpm --filter api exec prisma generate",
    "check": "pnpm run check:prisma && pnpm run test:gateway && pnpm test && pnpm --filter api build && pnpm --filter dashboard typecheck && pnpm --filter dashboard build",
    "test:integration": "bash scripts/test-security-integration.sh",
    "check:full": "pnpm run check && pnpm run test:integration",
    "test:gateway": "python3 -m unittest discover -s apps/gateway/tests -p 'test_*.py' -v",
    "gateway:doctor": "python3 apps/gateway/install_macos_service.py doctor",
    "gateway:install": "python3 apps/gateway/install_macos_service.py install",
    "gateway:status": "python3 apps/gateway/install_macos_service.py status",
    "gateway:restart": "python3 apps/gateway/install_macos_service.py restart",
    "gateway:logs": "python3 apps/gateway/install_macos_service.py logs --lines 80"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "turbo": "^2.10.5"
  },
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=22 <23"
  },
  "private": true
}
