{
  "terminal.integrated.cwd": "${workspaceFolder}",
  "files.exclude": {
    "**/node_modules": true,
    "**/.turbo": true,
    "**/dist": true,
    "**/.venv": true,
    "**/__pycache__": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.turbo": true,
    "**/dist": true,
    "**/.venv": true,
    "**/__pycache__": true,
    "**/apps/api/generated": true
  },
  "editor.rulers": [
    80,
    100
  ],
  "editor.minimap.enabled": false,
  "explorer.compactFolders": false
}
